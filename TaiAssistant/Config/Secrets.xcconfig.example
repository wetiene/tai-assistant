// Copy this file to Secrets.xcconfig (same directory) before running or archiving.
// Secrets.xcconfig is gitignored and must not be committed.
//
// Set AI_PROXY_BEARER_TOKEN to the TAI_PROXY_TOKEN value configured in Cloudflare Workers.
// After rotating a leaked token, update this file locally and rebuild.

AI_PROXY_BEARER_TOKEN = your_proxy_token_here
